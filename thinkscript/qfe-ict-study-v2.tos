# ============================================================
# QFE ICT PRE-EXPANSION - CHART STUDY / DIAGNOSTICS v2.0
# ============================================================
#
# Same engine as qfe-ict-scanner-v2.tos, plus visual output.
# Load this on a CHART (not the scanner) to see exactly which
# stage a ticker reached and where it died.
#
# Use it to validate against the acceptance cases written into
# the original v1.3 header:
#
#   CRWV before the vertical expansion  -> ARMED  (state 9)
#   CRWV on the expansion candle        -> IGNITION (state 11)
#   U after expansion                   -> LATE   (state 11, not first bar)
#
# ============================================================


# ============================================================
# INPUTS  (keep identical to the scanner)
# ============================================================

input sslLookback = 10;
input mssLookback = 8;
input dispCompareBars = 3;
input minBodyPct = 0.60;
input minCloseLocation = 0.70;
input requireSweepReclaim = yes;
input bslLookback = 8;
input bslClusterTolerance = 0.004;
input bslMinCluster = 2;
input maxDistanceToBslPct = 3.0;

input showLevels = yes;
input showBubbles = yes;
input showArrows = yes;


# ============================================================
# ENGINE  (identical to qfe-ict-scanner-v2.tos)
# ============================================================

def rng  = high - low;
def body = AbsValue(close - open);
def bull = close > open;

def bodyExpansion  = body > Highest(body[1], dispCompareBars);
def rangeExpansion = rng  > Highest(rng[1],  dispCompareBars);
def dominantBody   = bull and rng > 0 and body / rng >= minBodyPct;
def closeLocationOk = rng > 0 and (close - low) / rng >= minCloseLocation;

def displacement =
    dominantBody and bodyExpansion and rangeExpansion and
    close > high[1] and closeLocationOk;

def priorSSL = Lowest(low[1], sslLookback);
def sslRaidBar = low < priorSSL and (!requireSweepReclaim or close > priorSSL);

def structHighNow = Highest(high[1], mssLookback);
def fvgFormed = low > high[2];

def bslLvlNow = Highest(high[1], bslLookback);

def bslCluster =
    fold j = 1 to bslLookback + 1
    with c = 0
    do c + (
        if bslLvlNow > 0 and
           AbsValue(GetValue(high, j) - bslLvlNow) / bslLvlNow
               <= bslClusterTolerance
        then 1 else 0
    );

def bslOkNow = bslLvlNow > 0 and bslCluster >= bslMinCluster;

rec lastBearOpen =
    CompoundValue(1,
        if close[1] < open[1] then open[1] else lastBearOpen[1],
        Double.NaN);

def cisdNow = bull and !IsNaN(lastBearOpen) and close > lastBearOpen;

rec protectedLow =
    CompoundValue(1,
        if !IsNaN(protectedLow[1]) and close <= protectedLow[1] then Double.NaN
        else if IsNaN(protectedLow[1]) and sslRaidBar then low
        else protectedLow[1],
        Double.NaN);

def alive     = !IsNaN(protectedLow);
def alivePrev = !IsNaN(protectedLow[1]);

rec mssLevel =
    CompoundValue(1,
        if !alive then Double.NaN
        else if !alivePrev then structHighNow
        else mssLevel[1],
        Double.NaN);

rec dispDone =
    CompoundValue(1,
        if !alive then 0
        else if dispDone[1] == 1 then 1
        else if alivePrev and displacement then 1
        else 0, 0);

rec mssDone =
    CompoundValue(1,
        if !alive then 0
        else if mssDone[1] == 1 then 1
        else if dispDone == 1 and !IsNaN(mssLevel) and close > mssLevel then 1
        else 0, 0);

rec fvgLower =
    CompoundValue(1,
        if !alive then Double.NaN
        else if IsNaN(fvgLower[1]) and mssDone[1] == 1 and fvgFormed then high[2]
        else fvgLower[1], Double.NaN);

rec fvgUpper =
    CompoundValue(1,
        if !alive then Double.NaN
        else if IsNaN(fvgUpper[1]) and mssDone[1] == 1 and fvgFormed then low
        else fvgUpper[1], Double.NaN);

rec retDone =
    CompoundValue(1,
        if !alive then 0
        else if retDone[1] == 1 then 1
        else if !IsNaN(fvgLower[1]) and low <= fvgUpper[1] and high >= fvgLower[1] then 1
        else 0, 0);

# Retracement depth into the zone, captured on the touch bar.
# 0 = grazed the top, 1 = filled to the bottom.
rec retDepth =
    CompoundValue(1,
        if !alive then Double.NaN
        else if retDone == 1 and retDone[1] == 0 and
                !IsNaN(fvgUpper[1]) and (fvgUpper[1] - fvgLower[1]) > 0
        then Max(0, Min(1, (fvgUpper[1] - low) / (fvgUpper[1] - fvgLower[1])))
        else retDepth[1], Double.NaN);

def higherLowCond =
    alive and
    low[1] > protectedLow and
    low[1] < low[2] and
    low > low[1] and
    close > high[1];

rec hlDone =
    CompoundValue(1,
        if !alive then 0
        else if hlDone[1] == 1 then 1
        else if retDone[1] == 1 and higherLowCond then 1
        else 0, 0);

rec bslLevel =
    CompoundValue(1,
        if !alive then Double.NaN
        else if IsNaN(bslLevel[1]) and hlDone[1] == 1 and bslOkNow then bslLvlNow
        else bslLevel[1], Double.NaN);

rec bslCount =
    CompoundValue(1,
        if !alive then 0
        else if bslCount[1] == 0 and hlDone[1] == 1 and bslOkNow then bslCluster
        else bslCount[1], 0);

def distToBslPct =
    if !IsNaN(bslLevel) and bslLevel > 0
    then (bslLevel - close) / bslLevel * 100
    else Double.NaN;

def armedCond =
    !IsNaN(bslLevel[1]) and bslLevel[1] > 0 and
    low > low[1] and
    low[1] >= low[2] and
    high < bslLevel[1] and
    (bslLevel[1] - close) / bslLevel[1] * 100 >= 0 and
    (bslLevel[1] - close) / bslLevel[1] * 100 <= maxDistanceToBslPct;

rec armDone =
    CompoundValue(1,
        if !alive then 0
        else if armDone[1] == 1 then 1
        else if armedCond then 1
        else 0, 0);

rec trigDone =
    CompoundValue(1,
        if !alive then 0
        else if trigDone[1] == 1 then 1
        else if armDone[1] == 1 and cisdNow then 1
        else 0, 0);

def ignitionCond = !IsNaN(bslLevel) and close > bslLevel and displacement;

rec ignDone =
    CompoundValue(1,
        if !alive then 0
        else if ignDone[1] == 1 then 1
        else if trigDone[1] == 1 and ignitionCond then 1
        else 0, 0);

def state =
    if !alive then 0
    else if ignDone  == 1 then 11
    else if trigDone == 1 then 10
    else if armDone  == 1 then 9
    else if !IsNaN(bslLevel) then 8
    else if hlDone   == 1 then 7
    else if retDone  == 1 then 6
    else if !IsNaN(fvgLower) then 5
    else if mssDone  == 1 then 4
    else if dispDone == 1 then 3
    else if !IsNaN(mssLevel) then 2
    else 1;

def ignitionBar = ignDone == 1 and ignDone[1] == 0;

# Invalidation bar: was live last bar, closed through the protected low.
def invalidatedBar = alivePrev and !alive;


# ============================================================
# NOTE ON STATE NAMES
# ============================================================
#
# thinkScript def variables are numeric only - there is no
# string type, so the state-name expression cannot be hoisted
# into a variable and is inlined at each use site below.
#
# ============================================================


# ============================================================
# LEVELS
# ============================================================

plot ProtectedLow =
    if showLevels and alive then protectedLow else Double.NaN;
ProtectedLow.SetDefaultColor(Color.RED);
ProtectedLow.SetStyle(Curve.SHORT_DASH);
ProtectedLow.SetLineWeight(2);

plot MssLevel =
    if showLevels and alive and state >= 2 and state < 4 then mssLevel else Double.NaN;
MssLevel.SetDefaultColor(Color.YELLOW);
MssLevel.SetStyle(Curve.SHORT_DASH);

plot FvgTop =
    if showLevels and alive and !IsNaN(fvgUpper) then fvgUpper else Double.NaN;
FvgTop.SetDefaultColor(Color.CYAN);

plot FvgBottom =
    if showLevels and alive and !IsNaN(fvgLower) then fvgLower else Double.NaN;
FvgBottom.SetDefaultColor(Color.CYAN);

AddCloud(FvgTop, FvgBottom, Color.DARK_GRAY, Color.DARK_GRAY);

plot BslTarget =
    if showLevels and alive and !IsNaN(bslLevel) then bslLevel else Double.NaN;
BslTarget.SetDefaultColor(Color.GREEN);
BslTarget.SetStyle(Curve.LONG_DASH);
BslTarget.SetLineWeight(2);


# ============================================================
# STAGE ARROWS
# ============================================================

plot ArmedBar =
    if showArrows and state == 9 and state[1] < 9
    then low - rng * 0.5 else Double.NaN;
ArmedBar.SetPaintingStrategy(PaintingStrategy.BOOLEAN_ARROW_UP);
ArmedBar.SetDefaultColor(Color.YELLOW);
ArmedBar.SetLineWeight(3);

plot TriggerBar =
    if showArrows and state == 10 and state[1] < 10
    then low - rng * 0.9 else Double.NaN;
TriggerBar.SetPaintingStrategy(PaintingStrategy.BOOLEAN_ARROW_UP);
TriggerBar.SetDefaultColor(Color.ORANGE);
TriggerBar.SetLineWeight(4);

plot IgnitionBarPlot =
    if showArrows and ignitionBar then low - rng * 1.3 else Double.NaN;
IgnitionBarPlot.SetPaintingStrategy(PaintingStrategy.BOOLEAN_ARROW_UP);
IgnitionBarPlot.SetDefaultColor(Color.GREEN);
IgnitionBarPlot.SetLineWeight(5);

plot InvalidBar =
    if showArrows and invalidatedBar then high + rng * 0.5 else Double.NaN;
InvalidBar.SetPaintingStrategy(PaintingStrategy.BOOLEAN_ARROW_DOWN);
InvalidBar.SetDefaultColor(Color.RED);


# ============================================================
# TRANSITION BUBBLES  -  where each stage was reached
# ============================================================

AddChartBubble(
    showBubbles and state != state[1] and state > 0,
    low - rng * 0.2,
    if state == 1  then "SSL"
    else if state == 2  then "Struct"
    else if state == 3  then "Disp"
    else if state == 4  then "MSS"
    else if state == 5  then "FVG"
    else if state == 6  then "Retrace"
    else if state == 7  then "HL"
    else if state == 8  then "BSL"
    else if state == 9  then "ARMED"
    else if state == 10 then "TRIGGER"
    else "IGNITION",
    if state >= 9 then Color.GREEN
    else if state >= 5 then Color.CYAN
    else Color.GRAY,
    no);

AddChartBubble(
    showBubbles and invalidatedBar,
    high + rng * 0.2,
    "INVALID",
    Color.RED,
    yes);


# ============================================================
# LABELS  (current bar)
# ============================================================

AddLabel(yes,
    "ICT " +
    (if state == 0  then "flat"
     else if state == 1  then "SSL"
     else if state == 2  then "Struct"
     else if state == 3  then "Disp"
     else if state == 4  then "MSS"
     else if state == 5  then "FVG"
     else if state == 6  then "Retrace"
     else if state == 7  then "HL"
     else if state == 8  then "BSL"
     else if state == 9  then "ARMED"
     else if state == 10 then "TRIGGER"
     else "IGNITION") +
    " (" + state + ")",
    if state >= 9 then Color.GREEN
    else if state >= 5 then Color.CYAN
    else if state >= 1 then Color.GRAY
    else Color.DARK_GRAY);

AddLabel(alive,
    "Protected " + Round(protectedLow, 2) +
    "  |  risk " + Round((close - protectedLow) / close * 100, 2) + "%",
    Color.RED);

AddLabel(alive and !IsNaN(fvgLower),
    "FVG " + Round(fvgLower, 2) + " - " + Round(fvgUpper, 2) +
    (if !IsNaN(retDepth) then "  retrace " + Round(retDepth * 100, 0) + "%" else ""),
    Color.CYAN);

AddLabel(alive and !IsNaN(bslLevel),
    "BSL " + Round(bslLevel, 2) +
    " x" + bslCount +
    "  |  " + Round(distToBslPct, 2) + "% away",
    if distToBslPct <= maxDistanceToBslPct then Color.GREEN else Color.GRAY);

# Why a live setup has not advanced yet - the blocked stage.
AddLabel(alive and state < 9,
    "waiting: " +
        (if state <= 2 then "displacement"
         else if state == 3 then "MSS close > " + Round(mssLevel, 2)
         else if state == 4 then "FVG"
         else if state == 5 then "retrace into zone"
         else if state == 6 then "higher low"
         else if state == 7 then "BSL cluster (" + bslCluster + "/" + bslMinCluster + ")"
         else "compression <= " + maxDistanceToBslPct + "%"),
    Color.WHITE);
